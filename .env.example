HF_TOKEN=<Get on hf.com>

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=<...>
LLM_MODEL_NAME=<...>

PYDANTIC_AI_NO_BANNER=1

VOCAB_BASE_URL=https://www.vogelwarte.ch/wp-content/assets/json/bird

# Logging (defaults shown). Console = plain text on stderr, file = rotating log.
# LOG_LEVEL=INFO                  # DEBUG, INFO, WARNING, ERROR, CRITICAL (any case)
# LOG_FILE=                       # empty disables the file log; unset = <data dir>/logs/docdig.log
# LOG_MAX_BYTES=10485760          # rotate after 10 MiB
# LOG_BACKUP_COUNT=5              # keep docdig.log.1 ... docdig.log.5
# LOG_FILE_FORMAT=json            # json (one object per line) or text
# LOG_LIBS_LEVEL=WARNING          # httpx, openai, sqlalchemy, PIL, ...
