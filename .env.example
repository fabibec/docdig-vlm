HF_TOKEN=<Get on hf.com>

# LLM step (pipeline + benchmark). Required: LLM_BASE_URL, LLM_API_KEY. Defaults shown for the rest.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=<...>
LLM_MODEL_NAME=openai/gpt-6-luna   # <provider>/<model>, also used to look up prices
# LLM_REASONING_EFFORT=low        # none, minimal, low, medium, high, xhigh, max
# LLM_SEED=42
# LLM_PROMPT_FILE=data/prompts/llm_prompt.txt
# STEP_CONCURRENCY=100            # parallel LLM requests per document

# Web app (defaults shown)
# WEB_DATA_DIR=./data
# WEB_DB_PATH=                    # unset = <data dir>/state/app.db
# WEB_FRONTEND_DIR=frontend/dist/browser
# WEB_POOL_SIZE=2                 # documents processed in parallel (processes)
# WEB_MAX_UPLOAD_MB=200           # per file

# Optional local OCR step (`--steps ocr`, needs the ocr dependency group)
# OCR_MODEL=Abiray/OvisOCR2-GGUF
# OCR_LLM_FILE=OvisOCR2-F16.gguf
# OCR_MMPROJ_FILE=mmproj-F32.gguf

PYDANTIC_AI_NO_BANNER=1

VOCAB_BASE_URL=https://www.vogelwarte.ch/wp-content/assets/json/bird

# Logging (defaults shown). Console = plain text on stderr, file = rotating log.
# LOG_LEVEL=INFO                  # DEBUG, INFO, WARNING, ERROR, CRITICAL (any case)
# LOG_FILE=                       # empty disables the file log; unset = <data dir>/logs/docdig.log
# LOG_MAX_BYTES=10485760          # rotate after 10 MiB
# LOG_BACKUP_COUNT=5              # keep docdig.log.1 ... docdig.log.5
# LOG_FILE_FORMAT=json            # json (one object per line) or text
# LOG_LIBS_LEVEL=WARNING          # httpx, openai, sqlalchemy, PIL, ...
